generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  schedules     Schedule[]
  notifications Notification[]
}

model Schedule {
  id          Int      @id @default(autoincrement())
  studentId   Int
  course      String
  totalPages  Int
  totalDays   Int
  pagesPerDay Int
  fileUrl     String?
  pdfText     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student  Student        @relation(fields: [studentId], references: [id])
  tasks    StudyTask[]
  sessions StudySession[]
}

model StudyTask {
  id          Int      @id @default(autoincrement())
  scheduleId  Int
  day         Int
  startTime   String
  endTime     String
  pageStart   Int
  pageEnd     Int
  completed   Boolean  @default(false)
  rescheduled Boolean  @default(false)

  schedule Schedule @relation(fields: [scheduleId], references: [id])
}

model StudySession {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  startTime  String
  endTime    String

  schedule Schedule @relation(fields: [scheduleId], references: [id])
}

// Stores per-student in-app notifications in the database.
// Each row belongs to exactly one Student (studentId FK).
// This prevents cross-user leakage that would happen with
// a shared localStorage key on a shared device.
model Notification {
  id        Int      @id @default(autoincrement())
  studentId Int
  title     String
  body      String
  type      String   @default("info")  // info | reminder | success | warning
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}